                        "answer": "field_dsg_4ececabc41"
                    },
                    "rows": [
                        {
                            "question": "Is Armodafinil legal in Australia?",
                            "answer": "In Australia, armodafinil is a Schedule 4 prescription-only medication. You should hold a valid prescription from an Australian-registered medical practitioner before purchasing or using armodafinil."
                        },
